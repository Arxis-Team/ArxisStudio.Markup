<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ArxisStudio.Markup.Xaml</RootNamespace>
    <Description>Lossless XAML syntax model: trivia-preserving lexer and parser, namespaces and directives, markup-extension parsing, structured editing and round-trip serialization. Requires no Avalonia runtime assemblies.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../ArxisStudio.Markup/ArxisStudio.Markup.csproj" />
  </ItemGroup>

  <!--
    The contract asks for lexing and parsing to be benchmarked separately, and the lexer is not
    public API — measuring it is not a reason to make it one. Nothing else is granted access.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="ArxisStudio.Markup.Benchmarks" />
  </ItemGroup>

</Project>
