<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!--
    The one place the three libraries are versioned. They are developed and referenced together,
    so a version set anywhere else could only ever disagree with this one. Nothing is published:
    the version stamps the assemblies and gives CHANGELOG.md something to name.
  -->
  <PropertyGroup>
    <VersionPrefix>0.2.0</VersionPrefix>
    <VersionSuffix>preview.2</VersionSuffix>
  </PropertyGroup>

  <!--
    The contract requires XML documentation on all public APIs, and a consumer referencing these
    projects gets it in the IDE from the file beside the assembly.
  -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    Public API surface tracking. New public API must be declared in the project's
    PublicAPI.Unshipped.txt or the build fails. This is a review discipline rather than a
    distribution one — it is what makes an addition to the surface show up in a diff somebody
    reads — so it stays now that nothing is published.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

</Project>
