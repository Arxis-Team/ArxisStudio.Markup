<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:ArxisStudio.Markup.Xaml.Loader.Sample.Views"
        x:Class="ArxisStudio.Markup.Xaml.Loader.Sample.Views.MainWindow"
        Title="ArxisStudio.Markup — витрина"
        Width="1320" Height="860"
        MinWidth="1040" MinHeight="640"
        Background="{DynamicResource AppBackgroundBrush}">

  <DockPanel>

    <Border DockPanel.Dock="Top" Classes="appbar">
      <Grid ColumnDefinitions="Auto,*,Auto">

        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
          <Border Classes="mark">
            <TextBlock Text="&lt;/&gt;" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="ArxisStudio.Markup" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Classes="muted"
                       FontSize="11"
                       Text="XAML-документы без потерь и живые объекты Avalonia, построенные из них" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Border Classes="chip">
            <TextBlock Text="v0.1.0-preview" />
          </Border>
          <Border Classes="chip quiet">
            <TextBlock Text="Avalonia 12.1.1 · net10.0" />
          </Border>
        </StackPanel>

      </Grid>
    </Border>

    <!--
      The rail is a TabControl wearing the control theme in Themes/Showcase.axaml. A tab's content
      is built when the tab is first shown, which is what keeps five documents from being loaded
      before the window is on screen.
    -->
    <TabControl Classes="rail">

      <TabItem Classes="nav">
        <TabItem.Header>
          <StackPanel>
            <TextBlock Classes="nav-title" Text="Живой документ" />
            <TextBlock Classes="nav-sub" Text="правьте его — объекты идут следом" />
          </StackPanel>
        </TabItem.Header>
        <views:LiveView />
      </TabItem>

      <TabItem Classes="nav">
        <TabItem.Header>
          <StackPanel>
            <TextBlock Classes="nav-title" Text="Инспектор" />
            <TextBlock Classes="nav-sub" Text="правьте свойства — они уходят в файл и в дерево" />
          </StackPanel>
        </TabItem.Header>
        <views:InspectorView />
      </TabItem>

      <TabItem Classes="nav">
        <TabItem.Header>
          <StackPanel>
            <TextBlock Classes="nav-title" Text="Документ" />
            <TextBlock Classes="nav-sub" Text="обратная запись, восстановление и одна аккуратная правка" />
          </StackPanel>
        </TabItem.Header>
        <views:DocumentView />
      </TabItem>

      <TabItem Classes="nav">
        <TabItem.Header>
          <StackPanel>
            <TextBlock Classes="nav-title" Text="Ресурсы" />
            <TextBlock Classes="nav-sub" Text="файлы, которые документ только включает" />
          </StackPanel>
        </TabItem.Header>
        <views:ResourcesView />
      </TabItem>

      <TabItem Classes="nav">
        <TabItem.Header>
          <StackPanel>
            <TextBlock Classes="nav-title" Text="Объекты" />
            <TextBlock Classes="nav-sub" Text="из какой разметки взялся каждый объект" />
          </StackPanel>
        </TabItem.Header>
        <views:ObjectsView />
      </TabItem>

      <TabItem Classes="nav">
        <TabItem.Header>
          <StackPanel>
            <TextBlock Classes="nav-title" Text="Дизайн-атрибуты" />
            <TextBlock Classes="nav-sub" Text="один и тот же текст, загруженный дважды" />
          </StackPanel>
        </TabItem.Header>
        <views:DesignView />
      </TabItem>

    </TabControl>

  </DockPanel>

</Window>
