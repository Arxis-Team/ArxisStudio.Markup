<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:ArxisStudio.Markup.Xaml.Loader.Sample.Controls"
             xmlns:system="using:System"
             xmlns:edit="using:AvaloniaEdit"
             x:Class="ArxisStudio.Markup.Xaml.Loader.Sample.Views.ResourcesView">

  <Grid RowDefinitions="Auto,*" Margin="24">

    <StackPanel Grid.Row="0" Margin="0,0,0,18">
      <TextBlock Classes="h1" Text="Файлы, которые документ только включает" />
      <TextBlock Classes="lede"
                 Text="Палитра и файл бренда существуют только в памяти. Включения разрешаются через резолвер самой среды — именно это позволяет строить объекты из несохранённой правки. Смените акцент, и загруженное дерево пойдёт следом, а сам документ не изменится ни на символ." />
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="1*,16,1.05*">

      <Border Grid.Column="0" Classes="card">
        <DockPanel>

          <StackPanel DockPanel.Dock="Top">
            <TextBlock Classes="caption" Text="АКЦЕНТ, КОТОРЫЙ ОБЪЯВЛЯЕТ ПАЛИТРА" Margin="0,0,0,8" />
            <ComboBox x:Name="Accent" Width="200" HorizontalAlignment="Left">
              <ComboBox.ItemTemplate>
                <DataTemplate DataType="system:String">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Width="14"
                            Height="14"
                            CornerRadius="3"
                            Background="{Binding}"
                            BorderBrush="#55000000"
                            BorderThickness="1"
                            VerticalAlignment="Center" />
                    <TextBlock Classes="mono" Text="{Binding}" VerticalAlignment="Center" />
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Classes="caption" Text="THEMES/PALETTE.AXAML, В ПАМЯТИ" Margin="0,16,0,8" />
            <edit:TextEditor x:Name="PaletteText" Classes="code" IsReadOnly="True" Height="150" />
            <TextBlock Classes="caption" Text="ГРАФ ЗАВИСИМОСТЕЙ, КОТОРЫЙ ОБРАЗУЮТ ВКЛЮЧЕНИЯ" Margin="0,16,0,8" />
          </StackPanel>

          <ScrollViewer>
            <ItemsControl x:Name="GraphList" />
          </ScrollViewer>

        </DockPanel>
      </Border>

      <Border Grid.Column="2" Classes="card">
        <DockPanel>

          <TextBlock DockPanel.Dock="Top"
                     Classes="caption"
                     Text="ОБЪЕКТЫ, КОТОРЫЕ ОПИСЫВАЕТ ДОКУМЕНТ"
                     Margin="0,0,0,10" />

          <controls:PreviewSurface x:Name="Preview" DockPanel.Dock="Top" />

          <TextBlock DockPanel.Dock="Top"
                     Classes="caption"
                     Text="ЧТО ДАЛА СМЕНА ФАЙЛА"
                     Margin="0,16,0,8" />

          <ScrollViewer>
            <ItemsControl x:Name="UpdateList" />
          </ScrollViewer>

        </DockPanel>
      </Border>

    </Grid>

  </Grid>

</UserControl>
