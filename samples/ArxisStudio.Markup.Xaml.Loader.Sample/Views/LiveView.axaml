<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:ArxisStudio.Markup.Xaml.Loader.Sample.Controls"
             x:Class="ArxisStudio.Markup.Xaml.Loader.Sample.Views.LiveView">

  <Grid RowDefinitions="Auto,*" Margin="24">

    <StackPanel Grid.Row="0" Margin="0,0,0,18">
      <TextBlock Classes="h1" Text="Живой документ" />
      <TextBlock Classes="lede"
                 Text="Правьте документ слева. Ничего не компилируется и никакое приложение не перезапускается: уже работающие объекты приводятся в соответствие с тем, что вы написали, — наименьшей стратегией, которой заведомо достаточно. Какой именно, записано рядом, чтобы выбор был виден, а не выглядел магией." />
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="1.1*,16,1*">

      <Border Grid.Column="0" Classes="card">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
            <TextBlock Classes="caption" Text="ДОКУМЕНТ" />
            <TextBlock Grid.Column="1"
                       Classes="mono muted"
                       FontSize="11"
                       Text="file:///Views/CustomerView.axaml" />
          </Grid>
          <TextBox x:Name="Editor" Classes="code" />
        </DockPanel>
      </Border>

      <Grid Grid.Column="2" RowDefinitions="1.05*,14,1*">

        <Border Grid.Row="0" Classes="card">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top"
                       Classes="caption"
                       Text="ОБЪЕКТЫ, КОТОРЫЕ ОПИСЫВАЕТ ДОКУМЕНТ"
                       Margin="0,0,0,10" />
            <ScrollViewer>
              <controls:PreviewSurface x:Name="Preview" />
            </ScrollViewer>
          </DockPanel>
        </Border>

        <Border Grid.Row="2" Classes="card">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top"
                       Classes="caption"
                       Text="ЧТО СДЕЛАЛО ОБНОВЛЕНИЕ"
                       Margin="0,0,0,8" />
            <ScrollViewer>
              <ItemsControl x:Name="ReportList" />
            </ScrollViewer>
          </DockPanel>
        </Border>

      </Grid>

    </Grid>

  </Grid>

</UserControl>
