<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:ArxisStudio.Markup.Xaml.Loader.Sample.Controls"
             xmlns:edit="using:AvaloniaEdit"
             x:Class="ArxisStudio.Markup.Xaml.Loader.Sample.Views.PopulationView">

  <Grid RowDefinitions="Auto,*" Margin="24">

    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,18">
      <StackPanel>
        <TextBlock Classes="h1" Text="Вложенные контролы следуют за своим документом" />
        <TextBlock Classes="lede"
                   Text="CustomerChip скомпилирован в сборку витрины. Поставленный в другой документ, он строится Avalonia и показывает то, что было скомпилировано, — как бы его файл ни правили с тех пор. XamlLivePopulation подменяет, откуда берётся разметка: зарегистрированный документ наполняет каждый новый экземпляр — поставленный другим документом, построенный обновлением или созданный кодом. Правьте документ контрола: превью справа перестраиваются, потому что уже стоящие экземпляры регистрация не трогает." />
      </StackPanel>

      <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Top">
        <TextBlock Classes="caption" Text="ЭКЗЕМПЛЯРЫ НАПОЛНЯЮТСЯ" />
        <ToggleSwitch x:Name="Live"
                      IsChecked="True"
                      OnContent="из документа"
                      OffContent="из сборки"
                      ToolTip.Tip="Выключите, чтобы снять регистрацию и вернуть скомпилированную разметку" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="1.1*,16,1*">

      <Border Grid.Column="0" Classes="card">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
            <TextBlock Classes="caption" Text="ДОКУМЕНТ КОНТРОЛА" />
            <TextBlock Grid.Column="1"
                       Classes="mono muted"
                       FontSize="11"
                       Text="Controls/CustomerChip.axaml, как он скомпилирован" />
          </Grid>
          <edit:TextEditor x:Name="Editor" Classes="code" />
        </DockPanel>
      </Border>

      <Grid Grid.Column="2" RowDefinitions="Auto,14,Auto,14,*">

        <Border Grid.Row="0" Classes="card">
          <StackPanel>
            <TextBlock Classes="caption" Text="ДОКУМЕНТ, КОТОРЫЙ СТАВИТ ЕГО ДВАЖДЫ" Margin="0,0,0,10" />
            <controls:PreviewSurface x:Name="HostPreview" MinHeight="0" />
          </StackPanel>
        </Border>

        <Border Grid.Row="2" Classes="card">
          <StackPanel>
            <TextBlock Classes="caption" Text="ЭКЗЕМПЛЯР ИЗ КОДА — new CustomerChip()" Margin="0,0,0,10" />
            <controls:PreviewSurface x:Name="CodePreview" MinHeight="0" />
          </StackPanel>
        </Border>

        <Border Grid.Row="4" Classes="card">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Classes="caption" Text="ЧТО СДЕЛАЛА РЕГИСТРАЦИЯ" Margin="0,0,0,8" />
            <ScrollViewer>
              <ItemsControl x:Name="ReportList" />
            </ScrollViewer>
          </DockPanel>
        </Border>

      </Grid>

    </Grid>

  </Grid>

</UserControl>
