<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ArxisStudio.Markup.Xaml.Loader.Sample.Views.ObjectsView">

  <Grid RowDefinitions="Auto,*" Margin="24">

    <StackPanel Grid.Row="0" Margin="0,0,0,18">
      <TextBlock Classes="h1" Text="Из какой разметки взялся каждый объект" />
      <TextBlock Classes="lede"
                 Text="Построено по сведениям об источнике, которые записывает Avalonia, и прочитано обратно через проекцию, в которую были вклеены включения. Именно это оставляет объект, объявленный во включённом файле, приписанным к тому файлу, а не к строке этого файла с тем же номером, — и не даёт выдать вывод шаблона за собственное объявление контрола. Отчёт только для чтения: здесь ничего не редактируется, ни один объект не выделяется в превью и ничего поверх него не рисуется." />
    </StackPanel>

    <Border Grid.Row="1" Classes="card">
      <DockPanel>

        <StackPanel DockPanel.Dock="Top">
          <TextBlock x:Name="Summary" Classes="caption" Margin="0,0,0,10" />
          <Grid ColumnDefinitions="176,104,150,*" Margin="0,0,0,6">
            <TextBlock Grid.Column="0" Classes="caption" Text="ОБЪЕКТ" />
            <TextBlock Grid.Column="1" Classes="caption" Text="ОТКУДА" />
            <TextBlock Grid.Column="2" Classes="caption" Text="ОБЪЯВЛЕН В" />
            <TextBlock Grid.Column="3" Classes="caption" Text="ГДЕ ИМЕННО" />
          </Grid>
          <Border Classes="divider" Margin="0,0,0,10" />
        </StackPanel>

        <ScrollViewer>
          <StackPanel>
            <ItemsControl x:Name="Objects" />
            <TextBlock x:Name="Footnote" Classes="note" />
            <TextBlock Classes="caption" Text="ДИАГНОСТИКА" Margin="0,16,0,6" />
            <ItemsControl x:Name="DiagnosticList" />
          </StackPanel>
        </ScrollViewer>

      </DockPanel>
    </Border>

  </Grid>

</UserControl>
