<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:ArxisStudio.Markup.Xaml.Loader.Sample.Controls"
             xmlns:edit="using:AvaloniaEdit"
             x:Class="ArxisStudio.Markup.Xaml.Loader.Sample.Views.DesignView">

  <Grid RowDefinitions="Auto,Auto,*" Margin="24">

    <StackPanel Grid.Row="0" Margin="0,0,0,18">
      <TextBlock Classes="h1" Text="Один и тот же текст, загруженный дважды" />
      <TextBlock Classes="lede"
                 Text="Загрузчик Avalonia понимает четыре имени в пространстве имён дизайна и валит весь документ на любом другом, поэтому d:Text изымается из текста, который ему отдают, и применяется уже после. В режиме выполнения он изымается и не применяется — это и значит «пропустить значение только для дизайна». Документ сохраняет их все в любом случае, поэтому обе панели ниже загружены из одних и тех же символов." />
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="1*,16,1*" Margin="0,0,0,16">

      <Border Grid.Column="0" Classes="card">
        <StackPanel>
          <TextBlock Classes="caption" Text="ДИЗАЙН — ДАННЫХ НЕТ, ВИДНО ЗНАЧЕНИЕ ДЛЯ ДИЗАЙНА" Margin="0,0,0,10" />
          <!-- The design size is honoured, so the pane scrolls rather than cropping the control. -->
          <ScrollViewer HorizontalScrollBarVisibility="Auto">
            <controls:PreviewSurface x:Name="DesignPreview" />
          </ScrollViewer>
          <ItemsControl x:Name="DesignFacts" Margin="0,12,0,0" />
        </StackPanel>
      </Border>

      <Border Grid.Column="2" Classes="card">
        <StackPanel>
          <TextBlock Classes="caption" Text="ВЫПОЛНЕНИЕ — ЕСТЬ КОНТЕКСТ ДАННЫХ, ВИДНА ПРИВЯЗКА" Margin="0,0,0,10" />
          <ScrollViewer HorizontalScrollBarVisibility="Auto">
            <controls:PreviewSurface x:Name="RuntimePreview" />
          </ScrollViewer>
          <ItemsControl x:Name="RuntimeFacts" Margin="0,12,0,0" />
        </StackPanel>
      </Border>

    </Grid>

    <Border Grid.Row="2" Classes="card">
      <Grid ColumnDefinitions="1*,16,1*" RowDefinitions="Auto,*">

        <TextBlock Grid.Row="0" Grid.Column="0" Classes="caption" Text="ДОКУМЕНТ" Margin="0,0,0,8" />
        <TextBlock Grid.Row="0"
                   Grid.Column="2"
                   Classes="caption"
                   Text="ЧТО ПОЛУЧИЛА AVALONIA В РЕЖИМЕ ДИЗАЙНА"
                   Margin="0,0,0,8" />

        <edit:TextEditor Grid.Row="1" Grid.Column="0" x:Name="DocumentText" Classes="code" IsReadOnly="True" />
        <edit:TextEditor Grid.Row="1" Grid.Column="2" x:Name="ProjectedText" Classes="code" IsReadOnly="True" />

      </Grid>
    </Border>

  </Grid>

</UserControl>
