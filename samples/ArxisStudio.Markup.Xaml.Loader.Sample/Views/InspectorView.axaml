<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:ArxisStudio.Markup.Xaml.Loader.Sample.Controls"
             xmlns:inspector="using:ArxisStudio.Markup.Xaml.Loader.Sample.Inspector"
             x:Class="ArxisStudio.Markup.Xaml.Loader.Sample.Views.InspectorView">

  <!--
    The rows live here rather than with the application's templates because one of them needs a
    handler: a text field has to commit on Enter as well as on leaving, and the code that does
    that belongs to this view.
  -->
  <UserControl.DataTemplates>

    <DataTemplate DataType="inspector:TextPropertyRow">
      <Grid ColumnDefinitions="132,*" Margin="0,0,0,5">
        <TextBlock Grid.Column="0"
                   Classes="muted"
                   Text="{Binding Name}"
                   ToolTip.Tip="{Binding Origin}"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   Margin="0,0,10,0" />
        <TextBox Grid.Column="1"
                 Classes="field"
                 Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                 KeyDown="OnFieldKeyDown" />
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="inspector:TogglePropertyRow">
      <Grid ColumnDefinitions="132,*" Margin="0,0,0,5">
        <TextBlock Grid.Column="0"
                   Classes="muted"
                   Text="{Binding Name}"
                   ToolTip.Tip="{Binding Origin}"
                   VerticalAlignment="Center"
                   Margin="0,0,10,0" />
        <CheckBox Grid.Column="1" IsChecked="{Binding IsChecked, Mode=TwoWay}" />
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="inspector:ChoicePropertyRow">
      <Grid ColumnDefinitions="132,*" Margin="0,0,0,5">
        <TextBlock Grid.Column="0"
                   Classes="muted"
                   Text="{Binding Name}"
                   ToolTip.Tip="{Binding Origin}"
                   VerticalAlignment="Center"
                   Margin="0,0,10,0" />
        <ComboBox Grid.Column="1"
                  HorizontalAlignment="Stretch"
                  ItemsSource="{Binding Options}"
                  SelectedItem="{Binding Selected, Mode=TwoWay}" />
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="inspector:ExpressionPropertyRow">
      <Grid ColumnDefinitions="132,*" Margin="0,0,0,5">
        <TextBlock Grid.Column="0"
                   Classes="muted"
                   Text="{Binding Name}"
                   ToolTip.Tip="{Binding Origin}"
                   VerticalAlignment="Center"
                   Margin="0,0,10,0" />
        <Border Grid.Column="1" Classes="expression">
          <TextBlock Classes="mono"
                     Text="{Binding Text}"
                     TextTrimming="CharacterEllipsis"
                     ToolTip.Tip="{Binding Text}" />
        </Border>
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="inspector:ObjectNode">
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="{Binding Indent}">
        <TextBlock Text="{Binding Label}" />
        <TextBlock Classes="mono muted" Text="{Binding Detail}" VerticalAlignment="Center" />
      </StackPanel>
    </DataTemplate>

  </UserControl.DataTemplates>

  <Grid RowDefinitions="Auto,*" Margin="20">

    <StackPanel Grid.Row="0" Margin="0,0,0,18">
      <TextBlock Classes="h1" Text="Инспектор" />
      <TextBlock Classes="lede"
                 Text="Слева — объекты, которые описывает файл; в центре — они же, живые; справа — свойства выбранного. Правка в инспекторе не ставится на объект: она пишется атрибутом в документ, а объекты приводятся к нему тем же обновлением, что и на вкладке «Живой документ». Поэтому «применилось в превью» и «сохранилось в .axaml» — это одно действие, а не два, которые надо держать в согласии." />
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="214,12,*,12,336">

      <Border Grid.Column="0" Classes="card">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Classes="caption" Text="ОБЪЕКТЫ ДОКУМЕНТА" Margin="0,0,0,10" />
          <ListBox x:Name="Tree" Classes="tree" />
        </DockPanel>
      </Border>

      <Border Grid.Column="2" Classes="card">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
            <TextBlock Classes="caption" Text="ЖИВОЕ ПРЕВЬЮ" />
            <TextBlock x:Name="FilePath"
                       Grid.Column="1"
                       Classes="mono muted"
                       FontSize="11"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="220" />
          </Grid>
          <!-- A designed screen has a size of its own; the pane scrolls rather than cropping it. -->
          <ScrollViewer HorizontalScrollBarVisibility="Auto">
            <controls:PreviewSurface x:Name="Preview" />
          </ScrollViewer>
        </DockPanel>
      </Border>

      <Border Grid.Column="4" Classes="card">
        <DockPanel>

          <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Classes="caption" Text="СВОЙСТВА" />
            <TextBlock x:Name="Selected" Classes="mono" Margin="0,6,0,0" />
          </StackPanel>

          <Border DockPanel.Dock="Bottom" Classes="divider" Margin="0,10,0,10" />

          <StackPanel DockPanel.Dock="Bottom">
            <TextBlock Classes="caption" Text="ЧТО СДЕЛАЛА ПОСЛЕДНЯЯ ПРАВКА" Margin="0,0,0,8" />
            <ItemsControl x:Name="ReportList" />
          </StackPanel>

          <ScrollViewer>
            <ItemsControl x:Name="Properties" />
          </ScrollViewer>

        </DockPanel>
      </Border>

    </Grid>

  </Grid>

</UserControl>
