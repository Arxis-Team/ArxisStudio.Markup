<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:ArxisStudio.Markup.Xaml.Loader.Sample.Controls"
             xmlns:inspector="using:ArxisStudio.Markup.Xaml.Loader.Sample.Inspector"
             xmlns:edit="using:AvaloniaEdit"
             x:Class="ArxisStudio.Markup.Xaml.Loader.Sample.Views.InspectorView">

  <!--
    The rows live here rather than with the application's templates because one of them needs a
    handler: a text field has to commit on Enter as well as on leaving, and the code that does
    that belongs to this view.
  -->
  <UserControl.DataTemplates>

    <DataTemplate DataType="inspector:TextPropertyRow">
      <Grid ColumnDefinitions="132,*" Margin="0,0,0,5">
        <TextBlock Grid.Column="0"
                   Classes="muted"
                   Text="{Binding Name}"
                   ToolTip.Tip="{Binding Hint}"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   Margin="0,0,10,0" />
        <TextBox Grid.Column="1"
                 Classes="field"
                 Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                 KeyDown="OnFieldKeyDown" />
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="inspector:TogglePropertyRow">
      <Grid ColumnDefinitions="132,*" Margin="0,0,0,5">
        <TextBlock Grid.Column="0"
                   Classes="muted"
                   Text="{Binding Name}"
                   ToolTip.Tip="{Binding Hint}"
                   VerticalAlignment="Center"
                   Margin="0,0,10,0" />
        <CheckBox Grid.Column="1" IsChecked="{Binding IsChecked, Mode=TwoWay}" />
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="inspector:ChoicePropertyRow">
      <Grid ColumnDefinitions="132,*" Margin="0,0,0,5">
        <TextBlock Grid.Column="0"
                   Classes="muted"
                   Text="{Binding Name}"
                   ToolTip.Tip="{Binding Hint}"
                   VerticalAlignment="Center"
                   Margin="0,0,10,0" />
        <ComboBox Grid.Column="1"
                  HorizontalAlignment="Stretch"
                  ItemsSource="{Binding Options}"
                  SelectedItem="{Binding Selected, Mode=TwoWay}" />
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="inspector:ExpressionPropertyRow">
      <Grid ColumnDefinitions="132,*" Margin="0,0,0,5">
        <TextBlock Grid.Column="0"
                   Classes="muted"
                   Text="{Binding Name}"
                   ToolTip.Tip="{Binding Hint}"
                   VerticalAlignment="Center"
                   Margin="0,0,10,0" />
        <Border Grid.Column="1" Classes="expression">
          <TextBlock Classes="mono"
                     Text="{Binding Text}"
                     TextTrimming="CharacterEllipsis"
                     ToolTip.Tip="{Binding Text}" />
        </Border>
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="inspector:ObjectNode">
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="{Binding Indent}">
        <TextBlock Text="{Binding Label}" />
        <TextBlock Classes="mono muted" Text="{Binding Detail}" VerticalAlignment="Center" />
      </StackPanel>
    </DataTemplate>

  </UserControl.DataTemplates>

  <Grid RowDefinitions="Auto,*" Margin="20">

    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,18">
      <StackPanel>
        <TextBlock Classes="h1" Text="Инспектор" />
        <TextBlock Classes="lede"
                   Text="Слева — объекты, которые описывает файл; в центре — они же, живые; справа — свойства выбранного. Правка не ставится на объект: она пишется в документ через воркспейс, оттуда попадает в историю, и уже обновление приводит объекты в соответствие. Поэтому «применилось в превью», «сохранилось в .axaml» и «отменяется одной командой» — это одно действие, а не три, которые надо держать в согласии." />
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
        <Button x:Name="UndoButton" Content="Отменить" Click="OnUndo" />
        <Button x:Name="RedoButton" Content="Повторить" Click="OnRedo" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1">

      <!--
        The side panels keep a width of their own and the canvas takes what is left, which is what
        the splitters between them move. Minimums so that neither can be dragged shut.
      -->
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="214" MinWidth="150" MaxWidth="440" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" MinWidth="220" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="336" MinWidth="230" MaxWidth="560" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Classes="card">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Classes="caption" Text="ОБЪЕКТЫ ДОКУМЕНТА" Margin="0,0,0,10" />
          <!-- Wrapping, because the panel beside it is resizable and three buttons are wider
               than its narrowest useful width. -->
          <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,-6,-6">
            <Button x:Name="DeleteButton" Classes="tool" Content="Удалить" Click="OnDelete" />
            <Button x:Name="DuplicateButton" Classes="tool" Content="Дублировать" Click="OnDuplicate" />
            <Button x:Name="WrapButton"
                    Classes="tool"
                    Content="В Border"
                    Click="OnWrap"
                    ToolTip.Tip="Обернуть выбранный элемент в Border" />
          </WrapPanel>
          <ListBox x:Name="Tree" Classes="tree" />
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="1" Classes="gutter" />

      <Border Grid.Column="2" Classes="card">
        <DockPanel>

          <TextBlock x:Name="FilePath"
                     DockPanel.Dock="Top"
                     Classes="mono muted"
                     FontSize="11"
                     HorizontalAlignment="Right"
                     TextTrimming="CharacterEllipsis"
                     MaxWidth="260"
                     Margin="0,0,0,2" />

          <TabControl Classes="panel">

            <TabItem Classes="tab" Header="ЖИВОЕ ПРЕВЬЮ">
              <!-- A designed screen has a size of its own; the pane scrolls rather than cropping it. -->
              <ScrollViewer HorizontalScrollBarVisibility="Auto">
                <controls:PreviewSurface x:Name="Preview" />
              </ScrollViewer>
            </TabItem>

            <!--
              The document as it now reads, shown and not edited. There is one way into this file
              from this tab — the inspector, through the workspace — and a second one here would
              be a second history to keep in step.
            -->
            <TabItem Classes="tab" Header="РАЗМЕТКА">
              <edit:TextEditor x:Name="Markup" Classes="code" IsReadOnly="True" />
            </TabItem>

          </TabControl>

        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="3" Classes="gutter" />

      <Border Grid.Column="4" Classes="card">
        <DockPanel>

          <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="caption" Text="СВОЙСТВА" />
              <TextBlock x:Name="Count" Grid.Column="1" Classes="caption muted" />
            </Grid>
            <TextBlock x:Name="Selected" Classes="mono" Margin="0,6,0,0" />

            <!--
              Every settable member of the selected type is listed, which for a control is a couple
              of hundred. The box is how one of them is found; nothing here decides for the user
              which members are the interesting ones.
            -->
            <TextBox x:Name="Filter"
                     Classes="field"
                     PlaceholderText="фильтр по имени"
                     TextChanged="OnFilterChanged"
                     Margin="0,8,0,0" />
          </StackPanel>

          <Border DockPanel.Dock="Bottom" Classes="divider" Margin="0,10,0,10" />

          <StackPanel DockPanel.Dock="Bottom">
            <TextBlock Classes="caption" Text="ЧТО СДЕЛАЛА ПОСЛЕДНЯЯ ПРАВКА" Margin="0,0,0,8" />
            <ItemsControl x:Name="ReportList" />
          </StackPanel>

          <ScrollViewer>
            <ItemsControl x:Name="Properties" />
          </ScrollViewer>

        </DockPanel>
      </Border>

    </Grid>

  </Grid>

</UserControl>
