<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ArxisStudio.Markup.Xaml.Loader.Sample.Views.DocumentView">

  <ScrollViewer>
    <StackPanel Margin="24" Spacing="16">

      <StackPanel>
        <TextBlock Classes="h1" Text="Источник истины — документ" />
        <TextBlock Classes="lede"
                   Text="Документ хранит ровно тот снимок текста, из которого разобран, и каждый узел указывает внутрь него. Запись неизменённого документа — это копия, а не переформатирование, а правка выражается изменениями к его собственным диапазонам, так что не переписывается ничего, чего она не назвала. Для всего этого Avalonia не нужна: это та половина библиотеки, которой инструмент может пользоваться, не построив ни одного объекта." />
      </StackPanel>

      <Border Classes="card">
        <StackPanel>
          <TextBlock Classes="caption" Text="ЧТО ДАЛ РАЗБОР" Margin="0,0,0,10" />
          <ItemsControl x:Name="Facts" />
        </StackPanel>
      </Border>

      <Grid ColumnDefinitions="1*,16,1*">

        <Border Grid.Column="0" Classes="card">
          <StackPanel>
            <TextBlock Classes="caption" Text="ДВЕ ПРАВКИ, ОДНОЙ ПАЧКОЙ" Margin="0,0,0,10" />
            <TextBox x:Name="EditedRegion" Classes="code" IsReadOnly="True" Height="196" />
            <ItemsControl x:Name="EditFacts" Margin="0,12,0,0" />
          </StackPanel>
        </Border>

        <Border Grid.Column="2" Classes="card">
          <StackPanel>
            <TextBlock Classes="caption" Text="ДОКУМЕНТ, ПОЙМАННЫЙ НА ПОЛУСЛОВЕ" Margin="0,0,0,10" />
            <TextBox x:Name="MalformedText" Classes="code" IsReadOnly="True" Height="196" />
            <ItemsControl x:Name="RecoveryFacts" Margin="0,12,0,0" />
          </StackPanel>
        </Border>

      </Grid>

      <Border Classes="card">
        <StackPanel>
          <TextBlock Classes="caption"
                     Text="ЧТО СИНТАКСИЧЕСКАЯ МОДЕЛЬ ЗНАЕТ О ЗНАЧЕНИИ, НЕ ВИДЯ НИ ОДНОГО CLR-ТИПА"
                     Margin="0,0,0,10" />
          <ItemsControl x:Name="Extensions" />
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>

</UserControl>
