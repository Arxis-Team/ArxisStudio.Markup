<controls:ToolWindow xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:controls="using:ArxisStudio.Markup.Xaml.Loader.Sample.Controls"
                     x:Class="Contoso.Crm.ToolPalette"
                     Title="Палитра действий"
                     Width="240" Height="320">

  <!-- Корень — окно проекта, а не Window: что это окно, знает только его базовый тип. -->
  <StackPanel Margin="12" Spacing="6">
    <Button Content="Новый клиент" HorizontalAlignment="Stretch" />
    <Button Content="Импорт из CSV" HorizontalAlignment="Stretch" />
  </StackPanel>

</controls:ToolWindow>
