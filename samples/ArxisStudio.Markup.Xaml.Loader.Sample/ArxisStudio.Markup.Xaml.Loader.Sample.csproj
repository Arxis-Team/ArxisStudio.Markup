<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>ArxisStudio.Markup.Xaml.Loader.Sample</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/ArxisStudio.Markup.Xaml.Loader/ArxisStudio.Markup.Xaml.Loader.csproj" />
  </ItemGroup>

  <!--
    A desktop backend and a theme: the showcase is a window, and the documents it loads are drawn
    rather than described. Everything the window itself is made of is XAML, compiled by Avalonia's
    own build task from the .axaml files in this project.
  -->
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.AvaloniaEdit" />
  </ItemGroup>

  <!--
    Documents/ is data, not markup this application is built from: the showcase reads those files
    at run time through the three packages, which is the whole thing being demonstrated. Compiling
    them would make them part of the assembly and leave nothing to load.
  -->
  <ItemGroup>
    <AvaloniaXaml Remove="Documents/**/*.axaml" />
    <AvaloniaResource Remove="Documents/**/*.axaml" />
    <!--
      Included explicitly: taking them out of Avalonia's globs leaves them in no item group at
      all, and a file in no group is a file that does not reach the output.
    -->
    <Content Include="Documents/**/*.axaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
