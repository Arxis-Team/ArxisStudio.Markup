<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:reporting="using:ArxisStudio.Markup.Xaml.Loader.Sample.Reporting"
             x:Class="ArxisStudio.Markup.Xaml.Loader.Sample.ShowcaseApplication"
             RequestedThemeVariant="Dark">

  <!--
    One palette, named once. Not a pair of theme dictionaries: what the showcase is made of is
    class styles, and a DynamicResource inside a style setter is not resolved against the control
    asking for it, so it never sees the variant that control is wearing. Two sets would look like
    a choice the window does not actually offer. The Fluent theme above is told which variant to
    wear, and the surface a previewed document is drawn on holds a light scope of its own whatever
    this window wears — which is the only variant boundary here that means anything.
  -->
  <Application.Resources>
    <ResourceDictionary>

      <SolidColorBrush x:Key="AppBackgroundBrush" Color="#12141A" />
      <SolidColorBrush x:Key="AppPanelBrush" Color="#191C23" />
      <SolidColorBrush x:Key="AppElevatedBrush" Color="#20242D" />
      <SolidColorBrush x:Key="AppBorderBrush" Color="#2B303A" />
      <SolidColorBrush x:Key="AppTextBrush" Color="#E7EAF0" />
      <SolidColorBrush x:Key="AppMutedBrush" Color="#98A1B0" />
      <SolidColorBrush x:Key="AppAccentBrush" Color="#6BA1FF" />
      <SolidColorBrush x:Key="AppAccentSoftBrush" Color="#1E2A45" />
      <SolidColorBrush x:Key="AppPositiveBrush" Color="#56C08A" />
      <SolidColorBrush x:Key="AppNegativeBrush" Color="#E4707A" />
      <SolidColorBrush x:Key="AppWarningBrush" Color="#D8A657" />
      <SolidColorBrush x:Key="AppCodeBrush" Color="#0E1015" />

      <FontFamily x:Key="AppMonoFont">Cascadia Mono,Consolas,DejaVu Sans Mono,monospace</FontFamily>

    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://ArxisStudio.Markup.Xaml.Loader.Sample/Themes/Showcase.axaml" />
  </Application.Styles>

  <!--
    What a report row looks like is decided once, here, for every list in the window. A tab
    produces rows; this decides how a row is drawn.
  -->
  <Application.DataTemplates>

    <DataTemplate DataType="reporting:CaptionRow">
      <TextBlock Classes="caption" Text="{Binding Text}" Margin="0,12,0,4" />
    </DataTemplate>

    <DataTemplate DataType="reporting:NoteRow">
      <TextBlock Classes="note" Text="{Binding Text}" />
    </DataTemplate>

    <DataTemplate DataType="reporting:FieldRow">
      <Grid ColumnDefinitions="196,*" Margin="0,0,0,4">
        <TextBlock Grid.Column="0"
                   Classes="muted"
                   Text="{Binding Label}"
                   TextWrapping="Wrap"
                   Margin="0,0,10,0" />
        <TextBlock Grid.Column="1"
                   Classes="mono"
                   Text="{Binding Value}"
                   TextWrapping="Wrap" />
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="reporting:VerdictRow">
      <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,4">
        <TextBlock Grid.Column="0"
                   Classes="verdict-mark"
                   Classes.held="{Binding Held}"
                   Text="{Binding Mark}" />
        <TextBlock Grid.Column="1" Text="{Binding Claim}" TextWrapping="Wrap" />
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="reporting:DiagnosticRow">
      <Grid ColumnDefinitions="76,74,74,*" Margin="0,0,0,4">
        <TextBlock Grid.Column="0"
                   Classes="mono severity"
                   Classes.error="{Binding IsError}"
                   Classes.warning="{Binding IsWarning}"
                   Text="{Binding Severity}" />
        <TextBlock Grid.Column="1" Classes="mono" Text="{Binding Code}" />
        <TextBlock Grid.Column="2" Classes="mono muted" Text="{Binding Where}" />
        <TextBlock Grid.Column="3" Text="{Binding Message}" FontSize="12" TextWrapping="Wrap" />
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="reporting:ObjectRow">
      <Grid ColumnDefinitions="176,104,150,*" Margin="0,0,0,4">
        <TextBlock Grid.Column="0" Text="{Binding Type}" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="1" Classes="mono muted" Text="{Binding Origin}" />
        <TextBlock Grid.Column="2" Classes="mono muted" Text="{Binding Source}" />
        <TextBlock Grid.Column="3" Classes="mono" Text="{Binding Detail}" TextWrapping="Wrap" />
      </Grid>
    </DataTemplate>

  </Application.DataTemplates>

</Application>
