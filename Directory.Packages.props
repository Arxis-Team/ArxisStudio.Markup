<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!--
    Avalonia. See docs/adr/0002-avalonia-version.md.
    Referenced only by ArxisStudio.Markup.Xaml.Loader and its test project;
    PackageBoundaryTests enforces that the two lower packages stay Avalonia-free.
  -->
  <ItemGroup>
    <PackageVersion Include="Avalonia" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Markup.Xaml.Loader" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Headless" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="12.1.1" />
    <!-- The sample is a windowed showcase, so it needs a real backend and a theme. -->
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <!--
      Syntax highlighting for the XAML the showcase displays. The sample only: no package in src/
      references it, and none may. Its own Avalonia dependency is 12.0.0, which transitive pinning
      lifts to the 12.1.1 above.
    -->
    <PackageVersion Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
  </ItemGroup>

  <!-- Test stack. Avalonia.Headless.XUnit 12.1.1 depends on xunit.v3 3.2.2. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <!--
      Golden round-trip assertions are byte-exact and hand-rolled on purpose.
      Verify is pinned here for syntax-tree and diagnostic snapshots from milestone 3;
      it is deliberately not referenced yet.
    -->
    <PackageVersion Include="Verify.XUnit" Version="31.12.5" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

</Project>
