<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ArxisStudio.Markup.Benchmarks</RootNamespace>
    <!-- BenchmarkDotNet requires optimised builds to produce meaningful numbers. -->
    <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>
    <!--
      BenchmarkDotNet refuses static benchmark methods, and CA1822 asks for static any method
      that does not read instance state. A benchmark that reads none is still a benchmark.
    -->
    <NoWarn>$(NoWarn);CA1822</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/ArxisStudio.Markup.Xaml/ArxisStudio.Markup.Xaml.csproj" />
    <ProjectReference Include="../../src/ArxisStudio.Markup.Xaml.Loader/ArxisStudio.Markup.Xaml.Loader.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>

</Project>
